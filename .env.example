# ====================================================================
# AirGuard — Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your deployment environment:
#   cp .env.example .env
# ====================================================================

# Application Metadata
PROJECT_NAME="AirGuard — Intelligent Air Quality Prediction System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication (Change in production!)
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL connection string:
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/airguard_db"

# SQLite alternative (optional):
# DATABASE_URL="sqlite:///./airguard.db"
